<%- include('partials/head', { title: 'Video studio' }) %><section class="hero"><p class="eyebrow">VIDEO TO PRODUCT COPY</p><h1>A new angle.<br><span>A fresh description.</span></h1><p class="lede">Create a product draft from frames of a short YouTube video.</p></section><section class="studio"><p class="notice">Experimental: YouTube availability depends on the upstream downloader. Public, non-live videos only; maximum 3 minutes and 50 MB.</p><form action="/youtube/process" method="post" id="videoForm"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="form-group"><label for="youtube_url">YouTube URL</label><input type="url" id="youtube_url" name="youtube_url" placeholder="https://www.youtube.com/watch?v=…" required></div><div class="form-group"><label for="language">Output language</label><select id="language" name="language"><% for (const [code, name] of Object.entries({en:'English',tr:'Türkçe',es:'Español',de:'Deutsch',fr:'Français',zh:'中文'})) { %><option value="<%= code %>"><%= name %></option><% } %></select></div><button class="button">Generate from video ↗</button><p class="hint">One successful generation uses one credit. Failed requests are refunded.</p><p id="editorStatus" class="status" role="status"></p></form></section><%- include('partials/footer') %>
