<%- include('partials/head', { title: 'Image studio' }) %>
<section class="hero"><p class="eyebrow">YOUR NEXT PRODUCT STORY STARTS HERE</p><h1>Good products.<br><span>Better words.</span></h1><p class="lede">Turn product images into thoughtful, multilingual descriptions. Less blank-page time. More time for your store.</p><div class="chips"><span>Image-powered writing</span><span>6 languages</span><span>Editable copy</span></div></section>
<section class="studio"><div class="panel-heading"><div><p class="eyebrow">01 / CREATE</p><h2><%= translations.heading %></h2></div><% if (signedIn) { %><span class="credit-badge"><%= credits %> credits</span><% } %></div>
<% if (!signedIn) { %><p class="notice"><a href="/login">Sign in</a> or <a href="/register">create an account</a> to generate descriptions. New accounts start with 10 credits.</p><% } %>
<div class="source-box"><label for="sourceUrl"><%= translations.sourceUrlLabel %></label><div class="input-row"><input type="url" id="sourceUrl" placeholder="https://your-store.com/product"><button type="button" id="fetchImages" class="button secondary"><%= translations.fetchImagesButton %></button></div><p class="hint">Fetch up to eight images from a public HTTPS page, or paste image URLs below.</p></div>
<form action="/process" method="post" id="imageForm"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="form-group"><label for="language"><%= translations.chooseLanguageLabel %></label><select id="language" name="language"><% for (const [code, name] of Object.entries({en:'English',tr:'Türkçe',es:'Español',de:'Deutsch',fr:'Français',zh:'中文'})) { %><option value="<%= code %>" <%= code === language ? 'selected' : '' %>><%= name %></option><% } %></select></div><div id="imageFields"><div class="form-group image-field"><label for="imageUrl1"><%= translations.imageUrlLabel1 %></label><input type="url" id="imageUrl1" name="imageUrls[]" placeholder="https://example.com/product.jpg" required></div></div><div class="actions"><button type="button" class="button secondary" id="addImageField"><%= translations.addImageFieldButton %></button><button type="submit" class="button" <%= !signedIn ? 'disabled' : '' %>>Generate description ↗</button></div><p class="hint">One successful generation uses one credit. Images should show the same product.</p><p id="editorStatus" class="status" role="status" aria-live="polite"></p></form></section>
<section class="feature-grid"><article><span class="feature-number">01</span><h3>Bring the visuals</h3><p>Paste image links or fetch photos from your product page.</p></article><article><span class="feature-number">02</span><h3>Choose your audience</h3><p>Create copy in English, Turkish, Spanish, German, French or Chinese.</p></article><article><span class="feature-number">03</span><h3>Make it yours</h3><p>Copy your draft, refine the details and publish it in your store.</p></article></section><%- include('partials/footer') %>
