<%- include('partials/head', { title: 'Create an account' }) %><section class="auth-card"><p class="eyebrow">START WITH 10 FREE CREDITS</p><h1>Give your products a voice.</h1><% if (errorMessage) { %><p class="notice error" role="alert"><%= errorMessage %></p><% } %><form action="/register" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="form-group"><label for="username">Username</label><input id="username" name="username" autocomplete="username" minlength="3" maxlength="50" pattern="[A-Za-z0-9_.-]+" required></div><div class="form-group"><label for="email">Email</label><input type="email" id="email" name="email" autocomplete="email" maxlength="254" required></div><div class="form-group"><label for="password">Password</label><input type="password" id="password" name="password" autocomplete="new-password" minlength="12" maxlength="72" required><p class="hint">Use at least 12 characters and at most 72 UTF-8 bytes.</p></div><button class="button full">Create account ↗</button></form><p class="hint">Already have an account? <a href="/login">Sign in</a></p></section><%- include('partials/footer') %>
