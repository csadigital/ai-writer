<%- include('partials/head', { title: 'Sign in' }) %><section class="auth-card"><p class="eyebrow">WELCOME BACK</p><h1>Your writing studio awaits.</h1><% if (errorMessage) { %><p class="notice error" role="alert"><%= errorMessage %></p><% } %><% if (successMessage) { %><p class="notice success" role="status"><%= successMessage %></p><% } %><form action="/login" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="form-group"><label for="username">Username</label><input id="username" name="username" autocomplete="username" required maxlength="50"></div><div class="form-group"><label for="password">Password</label><input type="password" id="password" name="password" autocomplete="current-password" required></div><button class="button full">Sign in ↗</button></form><p class="hint">New here? <a href="/register">Create an account</a></p></section><%- include('partials/footer') %>
