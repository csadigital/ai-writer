<%- include('partials/head', { title: 'Your product description' }) %><section class="result-header"><p class="eyebrow">02 / YOUR DRAFT</p><h1>Ready for your finishing touch.</h1><p class="lede">Check the details, make it yours, then bring it to your store.</p></section><section class="studio"><% if (imageUrls.length) { %><div class="image-grid"><% imageUrls.forEach((url, index) => { %><img src="<%= url %>" alt="Product reference <%= index + 1 %>" loading="lazy" referrerpolicy="no-referrer"><% }); %></div><% } %><label for="description">Product description</label><textarea id="description" class="description-editor" rows="18"><%= description %></textarea><div class="actions"><a class="button secondary" href="/">Create another</a><button id="copyDescription" class="button">Copy description</button></div><form action="/translate" method="post" id="translateForm"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="description" id="translationText"><div class="input-row translation-row"><label for="translationLanguage">Translate to</label><select id="translationLanguage" name="language"><% for (const [code, name] of Object.entries({en:'English',tr:'Türkçe',es:'Español',de:'Deutsch',fr:'Français',zh:'中文'})) { %><option value="<%= code %>" <%= code === language ? 'selected' : '' %>><%= name %></option><% } %></select><button class="button secondary">Translate · 1 credit</button></div></form><p id="editorStatus" class="status" role="status" aria-live="polite"></p></section><%- include('partials/footer') %>
